# ==========================================
# Dead Poets Society API - Environment Variables
# ==========================================

# 🔑 SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# 🔐 DATABASE
MONGO_URI=mongodb://localhost:27017/dead-poets-society

# 🔑 JWT SECRET (Change this to a strong random string in production!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345

# 🔒 SECURITY
# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# 📧 EMAIL SERVICE (for future use)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# 📊 LOGGING
LOG_LEVEL=debug

# 🚨 RATE LIMITING
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# 💾 DATABASE BACKUPS (for future use)
# BACKUP_ENABLED=false
# BACKUP_SCHEDULE=0 2 * * *

# 🎯 DEPLOYMENT
# For production, ensure:
# - NODE_ENV=production
# - JWT_SECRET is changed to a strong random value
# - MONGO_URI points to production database
# - ALLOWED_ORIGINS only includes your production domain(s)
# - All logging is configured appropriately
